/*
 * Copyright (c) 2026, Jonathan S. Fisher.
 * Drools Rule Language (DRL) lexer macros.
 */

/* Standard identifier - letter/underscore followed by alphanumerics */
Identifier = [a-zA-Z_] [a-zA-Z0-9_]*

/* Variable binding pattern: $varName (Drools uses $ prefix for bound variables) */
DroolsVariable = \$ [a-zA-Z_] [a-zA-Z0-9_]*

/* Numbers - integers, floats, hex, with optional suffixes */
Number = (0[xX][0-9a-fA-F]+|[0-9]+\.[0-9]+|[0-9]+)(([eE][+-]?[0-9]+)?[ufdlUFDL]*)?

/* Time interval literals like 5d, 3h30m, 500ms etc (used in temporal constraints) */
TimeInterval = [0-9]+ [dhmsDHMS] ([0-9]+ [dhmsDHMS])*

/* Null-safe dereference operator (e.g., object!.property) - just the operator */
NullSafeOp = "!."

/* Hyphenated DRL attribute keywords - must match as single token */
HyphenatedKeyword = "ruleflow-group"|"agenda-group"|"activation-group"|"no-loop"|"lock-on-active"|"auto-focus"|"date-effective"|"date-expires"|"entry-point"
